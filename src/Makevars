TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libalot.a
PKG_LIBS = -L$(LIBDIR) -lalot

all: $(SHLIB)

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	cargo build --lib --release -p alot-r --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
